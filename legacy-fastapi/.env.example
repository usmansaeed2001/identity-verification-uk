# Copy to .env. Every secret below has a development default; production refuses to start with them.

# development | test | staging | production  (production disables mock mode and /demo)
ENVIRONMENT=development

# Local default is SQLite + in-process jobs; docker-compose overrides these with Postgres + arq.
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# What drivers and the host see (set to your cloudflared URL for a phone demo).
PUBLIC_BASE_URL=http://localhost:8000
# How the service reaches itself (mock vendor webhooks, demo host receiver).
INTERNAL_BASE_URL=http://localhost:8000
# Used when a verification has no callback_url of its own.
DEFAULT_CALLBACK_URL=

# Host platform credentials: X-API-Key, and the HMAC secret for X-Signature.
HOST_API_KEY=dev-api-key
HOST_SIGNING_SECRET=dev-host-signing-secret
# Signs our webhooks to the host (X-Webhook-Signature).
WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret
EVIDENCE_URL_SECRET=dev-evidence-url-secret
MOCK_PROVIDER_SECRET=dev-mock-provider-secret
# Fernet key for personal data at rest. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# local | s3
EVIDENCE_BACKEND=local
EVIDENCE_DIR=./data/evidence
S3_ENDPOINT_URL=
S3_BUCKET=evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Real share code + DVLA check code checks through Check Share Code (checksharecode.co.uk).
# Leave empty for mock mode only. Both must be "checksharecode" together.
RTW_PROVIDER=
LICENCE_PROVIDER=
# rtw_test_... = sandbox (test codes, never reaches gov.uk); rtw_live_... = real gov.uk checks.
CHECKSHARECODE_API_KEY=
# Recorded by gov.uk as the employer making each right to work check.
EMPLOYER_NAME=

# Simulated provider latency in seconds.
MOCK_DELAY_MIN_SECONDS=1
MOCK_DELAY_MAX_SECONDS=3
