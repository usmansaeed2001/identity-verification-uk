# Copy to .env. Read by Django (local runs) and docker compose.
# Development defaults are built in; config.settings.prod refuses to start with them.

# --- Check Share Code (checksharecode.co.uk): live share code + DVLA check code lookups ---
# rtw_test_... = sandbox (test codes like AA1AA1AA1, never reaches gov.uk)
# rtw_live_... = real gov.uk checks (10 free a month, then paid)
CHECKSHARECODE_API_KEY=
# Recorded by gov.uk as the employer making each right to work check.
EMPLOYER_NAME=

# Limits on paid live checks.
LIVE_CHECK_ATTEMPTS_PER_DAY=3
LIVE_CHECK_GLOBAL_DAILY_LIMIT=20

# --- Secrets (required in production) ---
# SECRET_KEY=
# Fernet keys, comma-separated, newest first. Generate with:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATA_ENCRYPTION_KEYS=

# --- Hosts (add your cloudflared URL for a phone demo) ---
# ALLOWED_HOSTS=localhost,127.0.0.1,backend,.trycloudflare.com
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080,https://*.trycloudflare.com
# Where links in emails point. 5173 = Vite dev server, 8080 = docker compose.
# FRONTEND_URL=http://localhost:5173

# --- Email (Mailpit catches everything in development: http://localhost:8025) ---
# REQUIRE_EMAIL_VERIFICATION=false
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# DEFAULT_FROM_EMAIL=Driver Onboarding <no-reply@example.com>

# --- Local runs without docker for the app (postgres/redis from compose) ---
# DATABASE_URL=postgres://driver:driver@localhost:5433/driver_onboarding
# REDIS_URL=redis://localhost:6379/0
# Run live checks inside the web request instead of a worker (slow, but no Celery needed):
# CELERY_TASK_ALWAYS_EAGER=true
